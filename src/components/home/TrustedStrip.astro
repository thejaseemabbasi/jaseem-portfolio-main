---
import { clients, clientsLabel } from '~/data/clients';
---

<section class="wrap trust" aria-label="Selected clients and platforms">
  <div class="trust-in">
    <p class="trust-lbl">{clientsLabel}</p>
    <div class="marquee">
      <div class="marquee-track" id="mtrack">
        {
          clients.map((client) => (
            <a
              class="plogo"
              href={client.href}
              target="_blank"
              rel="noopener noreferrer"
              style="text-decoration:none;color:inherit;"
            >
              {client.logo ? (
                <img
                  src={client.logo}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  style="width:20px;height:20px;object-fit:contain;border-radius:4px;"
                />
              ) : (
                client.shape && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                    set:html={client.shape}
                  />
                )
              )}
              {client.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('mtrack');
  if (track && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const clone = track.cloneNode(true) as HTMLElement;
    clone.removeAttribute('id');
    clone.setAttribute('aria-hidden', 'true');
    while (clone.firstChild) track.appendChild(clone.firstChild);
  }
</script>
