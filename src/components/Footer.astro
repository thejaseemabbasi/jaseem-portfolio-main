---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';
import { footerNav } from '~/data/navigation';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';

const services = (await getCollection('services'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const certBadges = [
  {
    name: 'Certified ScrumMaster (CSM) — Scrum Alliance',
    img: '/images/badges/csm.png',
    href: 'https://www.linkedin.com/in/jaseemabbasi/details/certifications/',
  },
  {
    name: 'Generative AI & Agile Project Management — PMI',
    img: '/images/badges/pmi.png',
    href: 'https://www.credly.com/users/jaseem-abbasi/badges/credly',
  },
  {
    name: 'AI Fluency Framework & Foundations — Anthropic',
    img: '/images/badges/anthropic.png',
    href: 'https://verify.skilljar.com/c/5wdw8qfzabuz',
  },
];

const legalLinks = footerNav.legal.filter((l) => l.label.toLowerCase() !== 'rss');
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div>
      <a class="ftr-brand" href="/">
        <img
          src={siteConfig.logo.footer.src}
          alt={`${siteConfig.name} — home`}
          width={siteConfig.logo.footer.width}
          height={siteConfig.logo.footer.height}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="ftr-about">{siteConfig.about}</p>
      <div class="ftr-certs" aria-label="Certifications">
        {
          certBadges.map((b) => (
            <a
              class="ftr-badge"
              href={b.href}
              target="_blank"
              rel="noopener noreferrer"
              title={b.name}
              aria-label={b.name}
            >
              <img src={b.img} alt={b.name} width="56" height="56" loading="lazy" decoding="async" />
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-labelledby="ftr-explore">
      <h2 id="ftr-explore">Explore</h2>
      <ul class="ftr-links">
        {footerNav.explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="ftr-services">
      <h2 id="ftr-services">Services</h2>
      <ul class="ftr-links">
        {services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Get in touch</h2>
      <div class="ftr-cbox">
        <Icon name="mail" class="ic-sm" />
        <span><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></span>
      </div>
      <div class="ftr-cbox">
        <Icon name="phone" class="ic-sm" />
        <span><a href={`tel:${siteConfig.contact.phoneHref}`}>{siteConfig.contact.phone}</a></span>
      </div>
      <div class="ftr-cbox">
        <Icon name="pin" class="ic-sm" />
        <span>{siteConfig.contact.location}</span>
      </div>
      <div class="ftr-soc" style="margin-top: 14px;">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
              <Icon name={s.icon} class="ic-sm" />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="wrap ftr-bot">
    <p>&copy; {year} {siteConfig.copyrightHolder}.</p>
    <nav aria-label="Legal">
      {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .ftr-certs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }

  .ftr-badge {
    display: inline-flex;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .ftr-badge:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .ftr-badge img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    display: block;
  }
</style>
