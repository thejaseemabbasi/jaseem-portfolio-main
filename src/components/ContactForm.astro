---
import Button from './Button.astro';
import siteConfig from '~/config/site';

const endpoint = siteConfig.contact.formEndpoint.trim();
const connected = endpoint.length > 0;
---

<form
  id="contact-form"
  class="form"
  method="post"
  action={connected ? endpoint : undefined}
  name="contact"
  novalidate={false}
>
  <input type="hidden" name="form-name" value="contact" />

  <div class="form-row">
    <div class="field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Your full name" />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
    </div>
  </div>

  <div class="field">
    <label for="cf-company">Company <span class="hint">(optional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="cf-type">What is this about?</label>
    <select id="cf-type" name="project_type">
      <option value="full-time-role">Full-time role (PM / Scrum / Product)</option>
      <option value="end-to-end-delivery" selected>End-to-end project delivery</option>
      <option value="scrum-execution">Scrum execution &amp; sprint cadence</option>
      <option value="product-discovery">Product discovery &amp; MVP strategy</option>
      <option value="agile-transformation">Agile transformation &amp; process optimization</option>
      <option value="presales-rfp">Presales, RFP &amp; commercial governance</option>
      <option value="ai-delivery-ops">AI-assisted delivery operations</option>
      <option value="something-else">Something else</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Project or role details</label>
    <p class="hint" id="cf-message-hint">
      Share the scope, team setup, timeline, or delivery challenge you’re looking to solve.
    </p>
    <textarea
      id="cf-message"
      name="message"
      rows="7"
      required
      aria-describedby="cf-message-hint"
      placeholder="A short paragraph is plenty to get started."></textarea>
  </div>

  <div class="hp" aria-hidden="true">
    <label for="cf-website">Leave this field empty</label>
    <input id="cf-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    !connected && (
      <p class="form-note">
        <strong>This form is not connected yet.</strong> Add your form provider's endpoint
        to <code>contact.formEndpoint</code> in <code>src/config/site.ts</code> and it will
        start posting. See <em>Contact form</em> in the README for Formspree, Netlify Forms
        and Web3Forms setups.
      </p>
    )
  }

  <p id="cf-error" class="form-note" hidden>
    Something went wrong while sending your message. Please try again or email {siteConfig.contact.email} directly.
  </p>

  <div>
    <Button type="submit" variant="ink" icon="mail" disabled={!connected}>Send message</Button>
  </div>
</form>

<dialog id="cf-thanks-modal" class="cf-modal" aria-labelledby="cf-modal-title">
  <div class="cf-modal-box">
    <span class="cf-modal-dot" aria-hidden="true">✓</span>
    <h3 id="cf-modal-title">Thank you for reaching out!</h3>
    <p>I’ve received your message and will get back to you shortly.</p>
    <button type="button" id="cf-modal-close" class="cf-modal-btn">Close</button>
  </div>
</dialog>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const modal = document.getElementById('cf-thanks-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('cf-modal-close');
  const errorEl = document.getElementById('cf-error');

  if (form && modal && closeBtn) {
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    const resetOnClose = () => {
      form.reset();
    };

    modal.addEventListener('close', resetOnClose);
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    form.addEventListener('submit', async (e) => {
      const action = form.getAttribute('action');
      if (!action) return;

      e.preventDefault();
      if (errorEl) errorEl.hidden = true;
      if (!form.reportValidity()) return;

      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch(action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          modal.showModal();
        } else if (errorEl) {
          errorEl.hidden = false;
        }
      } catch {
        if (errorEl) errorEl.hidden = false;
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .cf-modal {
    margin: auto;
    border: 1px solid rgba(16, 17, 16, 0.12);
    border-radius: 20px;
    padding: 0;
    max-width: 420px;
    width: calc(100% - 32px);
    background: #ffffff;
    color: #101110;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
  }

  .cf-modal::backdrop {
    background: rgba(16, 17, 16, 0.55);
    backdrop-filter: blur(4px);
  }

  .cf-modal-box {
    padding: 32px 28px;
    text-align: center;
  }

  .cf-modal-dot {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: #c8f14d;
    color: #101110;
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 16px;
  }

  .cf-modal-box h3 {
    margin: 0 0 8px;
    font-size: 22px;
    line-height: 1.25;
  }

  .cf-modal-box p {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.55;
    color: #5a5a54;
  }

  .cf-modal-btn {
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    padding: 11px 28px;
    font-size: 14px;
    font-weight: 600;
    background: #101110;
    color: #ffffff;
    transition: opacity 0.15s ease;
  }

  .cf-modal-btn:hover {
    opacity: 0.88;
  }
</style>

